# =============================================================================
# Vayu-X — Environment template
# Copy to .env and fill in real values.  NEVER commit .env
#   cp .env.example .env
# =============================================================================

# ---------- General ----------
ENV=development                       # development | staging | production
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
TZ=Asia/Kolkata

# ---------- Demo mode ----------
# Serve synthetic cyclone events instead of 501 stubs, so the dashboard and
# alert console can be demonstrated without a database, trained models, or live
# satellite feeds. Every demo payload is tagged synthetic and the UI shows a
# DEMO DATA badge. Set to false once the real pipeline is wired up.
DEMO_MODE=true

# ---------- Backend (API gateway) ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Database (PostgreSQL + PostGIS + TimescaleDB) ----------
POSTGRES_USER=vayux
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vayux
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://vayux:change-me@postgres:5432/vayux

# ---------- Redis (cache / pub-sub / task queue) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Object storage (MinIO / S3) ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET_RAW=vayux-raw
S3_BUCKET_PROCESSED=vayux-processed
S3_REGION=ap-south-1

# ---------- Service URLs (internal) ----------
MODEL_SERVICE_URL=http://ai-model:8001
ALERT_SERVICE_URL=http://alert-system:8002
BACKEND_URL=http://backend:8000

# ---------- AI model service ----------
MODEL_SERVICE_PORT=8001
MODEL_DEVICE=cpu                      # cpu | cuda
MODEL_CHECKPOINT_DIR=/app/models/checkpoints
IDENTIFICATION_MODEL=cyclone_detector_v1.onnx
CLASSIFICATION_MODEL=pattern_classifier_v1.onnx
PREDICTION_MODEL=track_convlstm_v1.pt
INFERENCE_BATCH_SIZE=8
MIN_DETECTION_CONFIDENCE=0.65

# ---------- Alert system ----------
ALERT_SERVICE_PORT=8002
ALERT_RULES_PATH=/app/config/alert_rules.yaml
ALERT_DEDUP_WINDOW_MINUTES=30
ALERT_DRY_RUN=true                    # true = log only, do not actually dispatch

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@vayux.local

# Firebase Cloud Messaging (Push)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Generic outbound webhook (e.g. NDMA/state EOC integration)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# ---------- Data pipeline / satellite sources ----------
PIPELINE_SCHEDULE_CRON=*/30 * * * *   # INSAT-3D full disk ~ every 30 min
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
CDS_API_KEY=                          # Copernicus / ERA5
NOAA_API_TOKEN=
INGEST_LOOKBACK_HOURS=6
INGEST_REGION_BBOX=30,60,25,100       # lat_min,lon_min,lat_max,lon_max (North Indian Ocean)

# ---------- Frontend (Vite — only VITE_* is exposed to the browser) ----------
# Leave the two URLs unset to route through the Vite dev proxy instead (see vite.config.js)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
# Dark basemap. Esri Dark Gray Canvas needs no API key; CARTO watermarks unkeyed tiles.
VITE_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{y}/{x}
VITE_DEFAULT_CENTER_LAT=15.0
VITE_DEFAULT_CENTER_LON=82.0
VITE_DEFAULT_ZOOM=5

# Dev-only: point the Vite proxy at a backend on a non-default port
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# ---------- Windy (optional) ----------
# Point Forecast API only — returns forecast values at a lat/lon, NOT map tiles.
# The animated weather map layers are a separate product (Map Forecast API).
# Get a key at https://api.windy.com/ and always set a domain restriction.
WINDY_POINT_API_KEY=

# ---------- Fast2SMS (alert dispatch) ----------
# Get a key at https://www.fast2sms.com/ (Dev API section).
# Manual send only: the dashboard shows a Send button, nothing dispatches on its own.
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_FLASH=true
SMS_COOLDOWN_SECONDS=60
SMS_MAX_SENDS_PER_RUN=25

# Default recipient shown in the dashboard alert panel
VITE_ALERT_TEST_NUMBER=6202972050

# ---------- Siren tower (ESP32 over USB serial) ----------
# The last-mile channel that needs no cellular network. Unlike SMS this MAY
# fire automatically — a sounding costs nothing and a tower that waits for a
# human defeats its purpose — so it ships disabled. Turn it on deliberately.
SIREN_ENABLED=false
# Leave blank to auto-detect the ESP32 by its USB adapter (CH340/CP210x/FTDI).
# Set explicitly if you have several boards plugged in, e.g. COM5 or /dev/ttyUSB0.
SIREN_PORT=
# Hard cap per sounding. A dropped link must not leave a siren wailing.
SIREN_MAX_SECONDS=30

# Fire the tower automatically when a classification clears the bar, with no
# operator action — the whole point of a last-mile tower. Off by default.
SIREN_AUTO_ON_UPLOAD=false
# A siren that cries wolf stops being evacuated for, so the model's own
# confidence gates the automatic path. Below this, an operator must press it.
SIREN_MIN_CONFIDENCE_PCT=70
SIREN_AUTO_SECONDS=15
