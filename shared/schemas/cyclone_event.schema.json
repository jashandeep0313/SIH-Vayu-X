{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vayux.sih/schemas/cyclone_event.schema.json",
  "title": "CycloneEvent",
  "description": "A tracked tropical cyclone system, its observation history, and its latest forecast. This is the primary object exchanged between the model service, backend, and alert system.",
  "type": "object",
  "required": ["id", "basin", "status", "first_seen", "last_seen", "observations"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Stable identifier for this cyclone event across its lifetime."
    },
    "name": {
      "type": ["string", "null"],
      "description": "Official IMD-assigned name, or an internal designation before naming."
    },
    "basin": {
      "type": "string",
      "enum": ["NIO", "BOB", "ARB"],
      "description": "NIO = North Indian Ocean, BOB = Bay of Bengal, ARB = Arabian Sea."
    },
    "status": {
      "type": "string",
      "enum": ["active", "weakened", "dissipated", "landfall", "archived"]
    },
    "first_seen": { "type": "string", "format": "date-time" },
    "last_seen": { "type": "string", "format": "date-time" },
    "peak_intensity_category": { "$ref": "#/$defs/intensityCategory" },
    "observations": {
      "type": "array",
      "description": "Chronological observation history, oldest first.",
      "items": { "$ref": "#/$defs/observation" }
    },
    "latest_forecast": {
      "description": "Most recently issued forecast. See forecast.schema.json.",
      "type": ["object", "null"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Free-form extras (source frames, pipeline run id, notes)."
    }
  },
  "$defs": {
    "intensityCategory": {
      "type": "string",
      "enum": ["LPA", "D", "DD", "CS", "SCS", "VSCS", "ESCS", "SuCS"],
      "description": "IMD North Indian Ocean intensity scale."
    },
    "patternType": {
      "type": "string",
      "enum": ["curved_band", "shear", "CDO", "banding_eye", "eye", "central_cold_cover"],
      "description": "Dvorak-derived cloud pattern class."
    },
    "observation": {
      "type": "object",
      "required": ["observed_at", "lat", "lon", "confidence"],
      "properties": {
        "observed_at": { "type": "string", "format": "date-time" },
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 },
        "bbox": {
          "type": "array",
          "description": "[lat_min, lon_min, lat_max, lon_max]",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "pattern_type": { "$ref": "#/$defs/patternType" },
        "intensity_category": { "$ref": "#/$defs/intensityCategory" },
        "est_wind_kt": {
          "type": "number",
          "minimum": 0,
          "description": "Estimated maximum sustained wind, knots."
        },
        "est_pressure_hpa": {
          "type": "number",
          "description": "Estimated central pressure, hectopascals."
        },
        "dvorak_t_number": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "Dvorak-equivalent T-number, for cross-reference by IMD analysts."
        },
        "radius_max_wind_km": { "type": "number", "minimum": 0 },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Model confidence. Below the configured threshold, downstream alerting routes to analyst review instead of auto-dispatch."
        },
        "class_probabilities": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "description": "Full probability distribution over pattern classes."
        },
        "source_frame": {
          "type": "string",
          "description": "Identifier of the satellite frame this observation came from."
        },
        "source_channels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "e.g. ['TIR1','TIR2','WV']"
        },
        "model_versions": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "explanation_uri": {
          "type": ["string", "null"],
          "description": "URI of the Grad-CAM / attention overlay for this inference."
        }
      }
    }
  }
}
